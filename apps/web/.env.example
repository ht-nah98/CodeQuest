VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_APP_ENV=local
# Dev builds only: 4 digits create the "HLV" coach review profile (opens every level). Keep the real value in .env.local.
VITE_COACH_PIN=
# To change the PIN: set the new value, then delete the HLV profile (Settings or DevTools >
# IndexedDB > codequest > profiles) and restart: it is recreated with the new PIN.
